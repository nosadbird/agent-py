# 阿里云百炼 API Key（必填，勿提交真实密钥）
DASHSCOPE_API_KEY=

# OpenAI 兼容 API 地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型名称
DASHSCOPE_MODEL=qwen-plus

# 模型调用参数
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=3

# Agent 行为限制
AGENT_MAX_STEPS=12
SHORT_TERM_MAX_TURNS=20

# Shell 工具限制
SHELL_TIMEOUT_SECONDS=30
SHELL_MAX_OUTPUT_CHARS=12000
# auto：Windows 使用 PowerShell，Linux/macOS 优先 Bash；也可填 powershell、bash 或 sh
AGENT_SHELL=auto
# Windows 使用 Git Bash 时可填写 bash.exe 的完整路径，其他情况留空
AGENT_BASH_PATH=
